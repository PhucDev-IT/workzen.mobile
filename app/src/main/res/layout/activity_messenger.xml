<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.chat.MessengerActivity">

    <LinearLayout
        android:layout_alignParentTop="true"
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:padding="@dimen/_10sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/baseline_navigate_before_24"
            app:tint="@color/white" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            app:shapeAppearanceOverlay="@style/one_rounded"
            android:scaleType="centerCrop"
            android:id="@+id/img_avatar"/>

        <TextView
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn Phúc"
            android:textColor="@color/white"
            android:maxLines="1"
            android:ellipsize="end"
            style="@style/TextView.Bold.Bold"/>
    </LinearLayout>

    <FrameLayout
        android:layout_above="@id/ll_bottom"
        android:layout_below="@id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:padding="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/r_chat"
            android:background="@color/background"/>
    </FrameLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="@dimen/_10sdp"
        android:gravity="center_vertical"
        android:id="@+id/ll_bottom">
        <ImageView
            android:id="@+id/img_attach_file"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            app:tint="@color/primary"
            android:src="@drawable/baseline_attach_file_24"/>
        <ImageView
            android:layout_marginStart="@dimen/_5sdp"
            android:id="@+id/img_mic"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_mic"
            app:tint="@color/primary" />

        <EditText
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_7sdp"
            android:layout_width="0dp"
            android:hint="Hãy nhập gì đó"
            style="@style/TextView.Regular.Regular"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:background="@drawable/bg_input_text"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👍"
            android:textSize="@dimen/_13sdp"/>
    </LinearLayout>
</RelativeLayout>