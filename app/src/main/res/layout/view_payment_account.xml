<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardBackgroundColor="@color/white"
    android:layout_height="match_parent">
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_margin="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ic_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_close_24"
                android:layout_gravity="end"/>


        <!--    Tab bar       -->
            <vn.gmi.workzen.widgets.roundcornerlayout.RoundCornerLinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="#f5f5f5"
                android:padding="@dimen/_3sdp"
                android:orientation="horizontal"
                android:layout_marginVertical="@dimen/_10sdp"
                app:corner_radius="@dimen/_10sdp">
                <TextView
                    android:id="@+id/tab_topup"
                    android:layout_width= "@dimen/_70sdp"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:gravity="center"
                    android:text="Nạp tiền"
                    android:textColor="@color/orange"
                    style="@style/TextView.Medium.Medium"
                    android:background="@drawable/bg_corner_border"/>

                <TextView
                    android:id="@+id/tab_withdraw"
                    android:layout_width= "@dimen/_70sdp"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:gravity="center"
                    android:text="Rút tiền"
                    android:textColor="@color/textSecondary"
                    style="@style/TextView.Medium.Medium"
                  />

                <TextView
                    android:id="@+id/tab_transaction"
                    android:layout_width= "@dimen/_70sdp"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_5sdp"
                    android:gravity="center"
                    android:text="Giao dịch"
                    android:textColor="@color/textSecondary"
                    style="@style/TextView.Medium.Medium"
                   />
            </vn.gmi.workzen.widgets.roundcornerlayout.RoundCornerLinearLayout>

            <vn.gmi.workzen.widgets.roundcornerlayout.RoundCornerLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E9EAEB"
                android:gravity="center"
                android:padding="@dimen/_5sdp"
                app:corner_radius="@dimen/_10sdp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active balance"
                    style="@style/TextView.Regular.Regular"
                    android:textSize="@dimen/text_size_medium"/>
                <TextView
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100.000.000 đ"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    style="@style/TextView.Bold.Bold"
                    android:textSize="@dimen/text_size_large"
                    android:textColor="@color/orange"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:gravity="center"

                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_scan_qr"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quét mã"
                        android:textSize="@dimen/text_size_small"
                        style="@style/TextView.Regular.Regular"/>
                </LinearLayout>

                <LinearLayout
                    android:gravity="center"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/iv_history"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_small"
                        android:text="Lịch sử"
                        style="@style/TextView.Regular.Regular"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_my_qr"
                    android:gravity="center"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_my_qr"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QR của tôi"
                        android:textSize="@dimen/text_size_small"
                        style="@style/TextView.Regular.Regular"/>
                </LinearLayout>
            </LinearLayout>

            </vn.gmi.workzen.widgets.roundcornerlayout.RoundCornerLinearLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/fragment_content"/>

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>