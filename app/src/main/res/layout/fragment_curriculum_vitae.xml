<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/_10sdp"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.profile.details.CurriculumVitaeFragment">

    <LinearLayout
        android:paddingVertical="@dimen/_5sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_border_bottom"
        android:orientation="horizontal"
       >

        <TextView
            style="@style/TextView.Bold.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông tin CC/CCCD/Hộ chiếu"
            android:textSize="@dimen/text_size_xmedium" />
    </LinearLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TableRow
            android:paddingVertical="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số CCCD"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_size_xxnormal" />
            <TextView
                android:id="@+id/tv_val_eid_number"
                android:layout_marginStart="@dimen/_10sdp"
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_size_xxnormal" />
        </TableRow>

        <TableRow
            android:paddingVertical="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Họ tên"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_size_xxnormal" />
            <TextView
                android:id="@+id/tv_val_name"
                android:layout_marginStart="@dimen/_10sdp"
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_size_xxnormal" />
        </TableRow>
        <TableRow
            android:paddingVertical="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giới tính"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_size_xxnormal" />
            <TextView
                android:id="@+id/tv_val_gender"
                android:layout_marginStart="@dimen/_10sdp"
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_size_xxnormal" />
        </TableRow>
        <TableRow
            android:paddingVertical="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ngày sinh"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_size_xxnormal" />
            <TextView
                android:id="@+id/tv_val_dob"
                android:layout_marginStart="@dimen/_10sdp"
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_size_xxnormal" />
        </TableRow>

        <TableRow
            android:paddingVertical="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ngày cấp"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_size_xxnormal" />
            <TextView
                android:id="@+id/tv_val_issue_date"
                android:layout_marginStart="@dimen/_10sdp"
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_size_xxnormal" />
        </TableRow>

        <TableRow
            android:paddingVertical="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TextView.Medium.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Có giá trị đến"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_size_xxnormal" />
