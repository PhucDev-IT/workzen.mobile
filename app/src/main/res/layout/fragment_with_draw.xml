<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    tools:context=".ui.account.withdraw.WithDrawFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_corner_border"
        android:layout_marginVertical="@dimen/_10sdp"
        android:padding="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:textSize="@dimen/text_size_xxnormal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/tv_guide_amount_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhập số tiền muốn rút"
            style="@style/TextView.Regular.Regular"/>
        <EditText
            android:layout_marginTop="@dimen/_5sdp"
            android:id="@+id/edt_amount"
            app:layout_constraintTop_toBottomOf="@id/tv_guide_amount_money"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_37sdp"
            android:background="@drawable/bg_input_text"
            android:hint="1.000.000"
            style="@style/TextView.Regular.Regular"
            android:textSize="@dimen/text_size_xnormal"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_5sdp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_35sdp"
            android:text="Nạp"
            app:layout_constraintEnd_toEndOf="@id/edt_amount"
            app:layout_constraintTop_toTopOf="@id/edt_amount"
            app:layout_constraintBottom_toBottomOf="@id/edt_amount"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_marginVertical="@dimen/_10sdp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ví đã liên kết"
            style="@style/TextView.Regular.Regular"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:background="@color/borderColor"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:itemCount="3"
        tools:listitem="@layout/item_select_wallet_view"/>

    <LinearLayout
        android:layout_marginVertical="@dimen/_10sdp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <View
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:background="@color/borderColor"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoặc"
            style="@style/TextView.Regular.Regular"/>
        <View
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:background="@color/borderColor"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        app:cardCornerRadius="@dimen/_5sdp"
        android:layout_margin="@dimen/_3sdp"
        app:cardBackgroundColor="#FAFAFA"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                />
            <LinearLayout
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thêm ngân hàng"
                    style="@style/TextView.Bold.Bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Liên kết với một ngân hàng hiện có hoặc mở một tài khoản mới"
                    style="@style/TextView.Regular.Regular"
                    android:textColor="@color/textSecondary"/>
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_add_24"
                app:tint="@color/orange" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        app:cardCornerRadius="@dimen/_5sdp"
        android:layout_margin="@dimen/_3sdp"
        app:cardBackgroundColor="#FAFAFA"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/img_logo_wallet"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                />
            <LinearLayout
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thêm ví điện tử"
                    style="@style/TextView.Bold.Bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Liên kết nhanh đến ví điện tử của bạn. Thanh toán nhanh chóng, tiện lợi"
                    style="@style/TextView.Regular.Regular"
                    android:textColor="@color/textSecondary"/>
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_add_24"
                app:tint="@color/orange" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        app:cardCornerRadius="@dimen/_5sdp"
        android:layout_margin="@dimen/_3sdp"
        app:cardBackgroundColor="#FAFAFA"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/img_logo_visa"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                />
            <LinearLayout
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thêm thẻ visa"
                    style="@style/TextView.Bold.Bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thanh toán qua thẻ visa, nhanh chóng, hỗ trợ trong và ngoài nước"
                    style="@style/TextView.Regular.Regular"
                    android:textColor="@color/textSecondary"/>
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_add_24"
                app:tint="@color/orange" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>