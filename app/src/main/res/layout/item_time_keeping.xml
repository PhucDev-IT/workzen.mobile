<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/_10sdp"
    android:layout_margin="@dimen/_5sdp"
    android:elevation="@dimen/_2sdp"
    android:id="@+id/ll_contain"
    android:background="@drawable/bg_corner_border"
    android:layout_height="wrap_content">
    <vn.gmi.workzen.widgets.roundcornerlayout.RoundCornerLinearLayout
       android:id="@+id/container_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@color/success"
        app:corner_radius="@dimen/_50sdp"
        android:padding="@dimen/_7sdp"
        app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:src="@drawable/ic_login"/>
    </vn.gmi.workzen.widgets.roundcornerlayout.RoundCornerLinearLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Giờ vào"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/container_icon"
        app:layout_constraintBottom_toBottomOf="@id/container_icon"
        android:layout_marginStart="@dimen/_5sdp"
        style="@style/TextView.Medium.Medium"
        android:textSize="@dimen/text_size_medium"
        android:textColor="@color/textSecondary"/>

    <TextView

        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="08:30 am"
        style="@style/TextView.Bold.Bold"
        android:textSize="@dimen/text_size_xxxmedium"
        app:layout_constraintTop_toBottomOf="@id/container_icon"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:layout_marginVertical="@dimen/_8sdp"/>
    <LinearLayout
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Muộn giờ"
            android:fontFamily="@font/helvetica_neue_regular"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/textSecondary"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_reward"
            style="@style/TextView.Medium.Medium"
            android:textSize="@dimen/text_size_normal"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>