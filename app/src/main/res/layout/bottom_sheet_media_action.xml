<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_line_top"
    android:orientation="horizontal"
    android:elevation="@dimen/_4sdp">

    <GridLayout
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        android:orientation="horizontal"
        android:useDefaultMargins="true">
        <LinearLayout
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/btn_photo"
            style="@style/chat_actionItem">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"

                android:background="@drawable/bg_corner_border">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/baseline_photo_library_24"
                    />
            </LinearLayout>
            <TextView
                android:layout_margin="@dimen/_5sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextView.Medium.Medium"
                android:textColor="@color/textPrimary"
                android:text="Ảnh" />
        </LinearLayout>

        <LinearLayout
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/btn_camera"
            style="@style/chat_actionItem">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
                android:background="@drawable/bg_corner_border">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/baseline_camera_24"
                    />
            </LinearLayout>
            <TextView
                android:layout_margin="@dimen/_5sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextView.Medium.Medium"
                android:textColor="@color/textPrimary"
                android:text="Camera" />
        </LinearLayout>

        <LinearLayout
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/btn_file"
            style="@style/chat_actionItem">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
                android:background="@drawable/bg_corner_border">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/baseline_insert_drive_file_24"
                    />
            </LinearLayout>
            <TextView
                android:layout_margin="@dimen/_5sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextView.Medium.Medium"
                android:textColor="@color/textPrimary"
                android:text="Tệp" />
        </LinearLayout>

        <LinearLayout
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/btn_location"
            style="@style/chat_actionItem">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
                android:background="@drawable/bg_corner_border">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/baseline_location_pin_24"
                    />
            </LinearLayout>
            <TextView
                android:layout_margin="@dimen/_5sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextView.Medium.Medium"
                android:textColor="@color/textPrimary"
                android:text="Vị trí" />
        </LinearLayout>

    </GridLayout>

    <LinearLayout
        android:id="@+id/ll_close"
        android:padding="@dimen/_5sdp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_navigate_before_24"/>
    </LinearLayout>

</LinearLayout>